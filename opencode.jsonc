{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "formatter": true,
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "pnpm dev *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm lint *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm typecheck *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm test *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm test:e2e *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm verify *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git switch *", "effect": "allow" },
    { "action": "shell", "resource": "git checkout *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr diff *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr checks *", "effect": "allow" },
    { "action": "shell", "resource": "supabase status *", "effect": "allow" },
    { "action": "shell", "resource": "supabase start *", "effect": "allow" },
    { "action": "shell", "resource": "supabase stop *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "supabase migration list *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "supabase gen types *",
      "effect": "allow",
    },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr create *", "effect": "ask" },
    { "action": "shell", "resource": "pnpm add *", "effect": "ask" },
    { "action": "shell", "resource": "pnpm install *", "effect": "ask" },
    { "action": "shell", "resource": "supabase db reset *", "effect": "ask" },
    { "action": "shell", "resource": "vercel *", "effect": "ask" },
    { "action": "shell", "resource": "supabase db push *", "effect": "deny" },
    {
      "action": "shell",
      "resource": "supabase db reset --linked *",
      "effect": "deny",
    },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git push --force *", "effect": "deny" },
    { "action": "shell", "resource": "git clean -fd *", "effect": "deny" },
    { "action": "shell", "resource": "vercel --prod *", "effect": "deny" },
    { "action": "shell", "resource": "gh pr merge *", "effect": "deny" },
    { "action": "read", "resource": ".env*", "effect": "ask" },
    { "action": "read", "resource": ".env.example", "effect": "allow" },
    { "action": "edit", "resource": "supabase/migrations/*", "effect": "ask" },
  ],
  "agents": {
    "reviewer": {
      "description": "Reviews code changes for bugs, security, mobile UX, and missing tests",
      "mode": "subagent",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
      ],
    },
    "db-reviewer": {
      "description": "Reviews SQL migrations, RLS policies, indexes, and storage policies",
      "mode": "subagent",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
      ],
    },
  },
}
